# Standalone POS environment variables template
# Create a copy named .env and fill in your values.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Receiver Account (The generic service account that the terminal signs into silently after a PIN check)
VITE_RECEIVER_EMAIL=terminal@yourrestaurant.com
VITE_RECEIVER_PASSWORD=secure-terminal-password-here
