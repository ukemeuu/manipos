# ---------------------------------------------------------------------------
# ManiPOS environment
# Copy to `.env` for local development. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project URL (SaaS project, not a single-tenant legacy project)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable / anon key — safe to ship in the browser, protected by RLS.
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional: service role key used only by scripts/onboard-tenant.mjs.
# NEVER prefix this with VITE_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Super admin console (?page=superadmin). Prefer an authenticated Supabase user
# on the allow-list over a shared passcode.
VITE_SUPER_ADMIN_EMAILS=owner@manipos.com
VITE_SUPER_ADMIN_PASSCODE=

# Public support / branding
VITE_SUPPORT_EMAIL=support@manipos.com
VITE_APP_URL=https://manipos.com
