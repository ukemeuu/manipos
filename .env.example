# ---------------------------------------------------------------------------
# ManiPOS environment
# Copy to `.env` for local development. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project URL (SaaS project)
VITE_SUPABASE_URL=https://ptaqejtyhdbhmhrhuxcj.supabase.co

# Publishable / anon key — safe to ship in the browser, protected by RLS.
VITE_SUPABASE_ANON_KEY=sb_publishable_r8PHCMuMpU_1dybpfrz7Kw_5-9qID7g

# Super admin console (?page=superadmin). Comma-separated allow-list of
# Supabase Auth emails. The master passcode lives only in the database
# (platform_settings.super_admin_passcode) — never put it in an env var,
# because VITE_* values are inlined into the public JS bundle.
VITE_SUPER_ADMIN_EMAILS=owner@manipos.com

# Optional: Sentry DSN for error tracking. When unset, the Telegram error
# pipeline (scripts/error-forwarder.py) is used instead.
VITE_SENTRY_DSN=

# M-Pesa Daraja STK push. The Daraja credentials live in Supabase edge function
# secrets (see M-PESA.md) — this flag only turns the client-side prompt on.
# Set to true once the mpesa-* functions are deployed and credentials are set.
VITE_MPESA_ENABLED=false

# Optional: displayed in Sentry releases.
VITE_APP_VERSION=

# Hostinger deployment (FTP). Never commit real credentials.
FTP_HOST=ftp.manipos.com
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_REMOTE_DIR=/

# Staging target (used by `scripts/deploy-hostinger.sh --target staging`).
# Only needed if staging lives somewhere other than public_html/staging.
FTP_STAGING_REMOTE_DIR=/staging/

# ---------------------------------------------------------------------------
# Telegram alerts (used by scripts/uptime-monitor.py and
# scripts/error-forwarder.py). In CI these come from repository secrets.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Service role key — server-side scripts only. NEVER prefix this with VITE_.
SUPABASE_SERVICE_KEY=
